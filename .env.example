# Copy to .env.local and fill in. .env.local is git-ignored and never sent to the browser.

# --- Claude -------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Any model id your account offers.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Cisco CML MCP server -----------------------------------------------------
# stdio  : Tiny Snitch launches the server itself (set COMMAND, optionally ARGS and ENV).
# http   : Tiny Snitch connects to a running Streamable HTTP server (set URL, optionally HEADERS).
CML_MCP_TRANSPORT=stdio

# stdio
CML_MCP_COMMAND=
# Either a JSON array: ["-m","cml_mcp"]   or a plain string: -m cml_mcp --verbose
# To reference a variable from CML_MCP_ENV (so a secret stays out of the command line), write {{NAME}}, not ${NAME}:
# Next.js expands ${NAME} in .env files before Tiny Snitch sees it, leaving it empty. {{NAME}} becomes ${NAME}
# when the server is launched, which is what mcp-remote expects. Example for mcp-remote:
#   CML_MCP_ARGS='["-y","mcp-remote","https://cml.example/mcp","--header","X-Authorization:{{CML_AUTH_HEADER}}"]'
CML_MCP_ARGS=
# Extra environment for the server process, as JSON: {"CML_URL":"https://cml.local","CML_USERNAME":"admin"}
# Only these variables (plus a safe default set such as PATH) reach the server process.
CML_MCP_ENV=

# http
CML_MCP_URL=
# JSON object of request headers: {"Authorization":"Bearer ..."}
CML_MCP_HEADERS=

# --- Real devices (optional; CML is not required) -----------------------------
# Sites, devices and credential *references* in a YAML file. See inventory.example.yaml.
# Passwords are never written in the file; it says env:NAME or file:/path and the value is read when needed.
TS_INVENTORY_FILE=
# Old IOS images need SHA-1 key exchange and CBC ciphers. Off unless you set this to 1.
TS_SSH_LEGACY_ALGORITHMS=

# NetBox as the source of truth (sites, devices, primary IPs, cables). NetBox holds no credentials, so SSH access
# for the devices it lists comes from here. A site is production unless it carries the tag "lab".
NETBOX_URL=
NETBOX_TOKEN=
NETBOX_SSH_USERNAME=
NETBOX_SSH_PASSWORD=
NETBOX_SSH_KEY_FILE=
NETBOX_DEFAULT_ENVIRONMENT=production

# --- App ----------------------------------------------------------------------
APP_PORT=3000
DATABASE_URL=file:./data/tiny-snitch.db
